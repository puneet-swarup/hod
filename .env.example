# House of Desserts — example environment file.
# Copy to .env and fill in real values. NEVER commit the real .env.
#
#   Copy-Item .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Paste the generated value into SECRET_KEY below.

# --- Business Identity ---
APP_NAME=House of Desserts
APP_TAGLINE=Artisan Bakes & Cakes
FSSAI_NUMBER=
GSTIN=
PHONE=
ADDRESS=
EMAIL=
CURRENCY=₹

# --- Application ---
DEBUG=false
# REQUIRED when DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production if this is empty.
SECRET_KEY=
DB_URL=sqlite:///data/bakery.db
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Server ---
BIND_HOST=127.0.0.1
BIND_PORT=8000

# --- WhatsApp / Messaging ---
WHATSAPP_ENABLED=true
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_MESSAGES_FILE=config/messages.json

# --- Printer ---
PRINTER_TYPE=file
PRINTER_DEVICE=
PRINTER_WIDTH=80

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_SCHEDULE=daily

# --- Reports ---
REPORTS_DIR=./reports

# --- Invoice Numbering ---
INVOICE_PREFIX=HOD
INVOICE_START_NUMBER=1
